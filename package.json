{
  "name": "job-scout",
  "private": true,
  "version": "2.8.4",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "EMBED_WORKER=1 tsx watch --clear-screen=false apps/api/src/index.ts",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "NODE_ENV=production tsx apps/api/src/index.ts",
    "start:worker": "NODE_ENV=production tsx apps/worker/src/index.ts",
    "once": "NODE_ENV=production tsx apps/worker/src/once.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:import-v1": "tsx scripts/import-v1.ts",
    "bench:models": "tsx scripts/bench-models.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts",
    "lint:strict": "pnpm lint --max-warnings 0",
    "db:repair": "tsx scripts/repair-data.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10",
    "remark-gfm": "^4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "undici": "^8.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@job-scout/lint-config": "workspace:*",
    "eslint": "10.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
