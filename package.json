{
  "name": "job-scout",
  "private": true,
  "version": "2.14.6",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "EMBED_WORKER=1 tsx watch --env-file-if-exists=.env --clear-screen=false apps/api/src/index.ts",
    "dev:api": "tsx --env-file-if-exists=.env apps/api/src/index.ts",
    "dev:worker": "tsx --env-file-if-exists=.env apps/worker/src/index.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env apps/api/src/index.ts",
    "start:worker": "NODE_ENV=production tsx --env-file-if-exists=.env apps/worker/src/index.ts",
    "once": "NODE_ENV=production tsx --env-file-if-exists=.env apps/worker/src/once.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:repair-career-ops-reversals": "tsx --env-file-if-exists=.env packages/core/src/cli/repair-career-ops-reversals.ts",
    "db:repair-last-good-jd": "tsx --env-file-if-exists=.env packages/core/src/cli/repair-last-good-jd.ts",
    "db:repair-materials-status": "tsx --env-file-if-exists=.env packages/core/src/cli/repair-materials-status.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages",
    "lint:strict": "pnpm lint --max-warnings 0",
    "db:repair": "tsx --env-file-if-exists=.env packages/core/src/cli/repair-data.ts",
    "db:repair-triage-archives": "tsx --env-file-if-exists=.env packages/core/src/cli/repair-triage-archives.ts",
    "db:repair-prototype-slugs": "tsx --env-file-if-exists=.env packages/core/src/cli/repair-prototype-slugs.ts",
    "db:retriage-timezone": "tsx --env-file-if-exists=.env packages/core/src/cli/retriage-timezone.ts",
    "db:repair-title-slugs": "tsx --env-file-if-exists=.env packages/core/src/cli/repair-title-slugs.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@job-scout/lint-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
