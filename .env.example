# Database — leave DATABASE_URL unset for embedded PGlite
# DATABASE_URL=postgresql://job_scout:job_scout@localhost:5432/job_scout
PGLITE_DATA_DIR=.data/pglite
# PGSSL=0            # disable TLS for a local Postgres
# PG_POOL_MAX=6
# PG_IDLE_MS=10000   # 0 keeps connections open (port-forwards)

# Auth: dev (no auth) | token (password session + Bearer) | cf_access (Cloudflare Access header)
AUTH_MODE=dev
AUTH_PASSWORD=job-scout
API_TOKEN_SEED=dev-agent-token

# Runtime
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
EMBED_WORKER=1          # run the worker inside the API process (dev only)
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1500
WORKER_SCHEDULER=1      # 0 when CronJobs own discovery/watch/retention
ATS_USER_AGENT=job-scout/2 (local; no apply)

# Observability — /metrics on its own port (0 = off); logs are JSON in production, pretty in dev
METRICS_PORT=9464
LOG_FORMAT=pretty
LOG_LEVEL=info

# LLM — any OpenAI-compatible gateway; must end in /v1. Models per operation are chosen in Settings › AI.
# `pnpm dev` uses OPENAI_BASE_URL (this process). Docker Compose ignores it and uses
# COMPOSE_OPENAI_BASE_URL, defaulting to http://host.docker.internal:8317/v1
# so the container can reach a gateway on the host. 127.0.0.1 inside a container is the container.
OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# COMPOSE_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_TIMEOUT_MS=180000

# Dedicated job-scout Steel (optional). Empty = off. Not the shared human browser.
# STEEL_BASE_URL=http://steel.example:3000
# BROWSER_MCP_URL=http://playwright.example:8931/mcp

# a WAHA server (optional). Empty = NoopSender; originating jobs still succeed.
# WAHA_BASE_URL=
# WAHA_SESSION=default
# WAHA_API_KEY=
# WAHA_WEBHOOK_KEY=
